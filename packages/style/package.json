{
  "name": "@konvoulgaris/soong-style",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konvoulgaris/soong.js.git",
    "directory": "packages/style"
  },
  "type": "module",
  "exports": {
    "./eslint": {
      "types": "./dist/base.config.d.ts",
      "default": "./dist/base.config.js"
    },
    "./eslint-react": {
      "types": "./dist/react.config.d.ts",
      "default": "./dist/react.config.js"
    },
    "./prettier": {
      "default": "./dist/prettier.json"
    },
    "./prettier-tailwind": {
      "types": "./dist/prettier-tailwind.config.d.ts",
      "default": "./dist/prettier-tailwind.config.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@shadcn/lint": "^0.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "typescript-eslint": "^8.70.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "prettier-plugin-tailwindcss": {
      "optional": true
    }
  }
}
